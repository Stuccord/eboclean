# Copy this file to .env.local and fill in your keys.

# --- AI scanning ---
# Get a key at https://console.anthropic.com (Settings -> API Keys).
ANTHROPIC_API_KEY=
# Set to 1 to force sample results (no AI calls), e.g. for filming UI demos.
CLEAN_SWEEP_DEMO=0

# --- Payments (Paystack, charged in US dollars) ---
# Leave PAYSTACK_SECRET_KEY empty to use demo payments (no real charges).
# Use your TEST secret key (sk_test_...) first: Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
# Create two USD plans in Paystack (Products -> Plans) and paste their plan codes (PLN_...):
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_YEARLY=

# --- Accounts & sync (Supabase) ---
# Leave these empty to use demo accounts (stored on this computer, codes shown on screen).
# Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only secret. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign cookies. Required in production. Any long random string.
APP_SECRET=
# Public URL of the app in production, e.g. https://cleansweep.app
APP_URL=
